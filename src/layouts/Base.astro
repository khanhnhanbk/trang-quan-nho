---
// Khung chung mọi trang: <head>, font, ảnh xem trước khi chia sẻ, giữ lựa chọn sáng/tối.
import '../styles/global.css';
const { title, description = '', nganh = 'ca-phe', image = '/og.jpg' } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const img = new URL(image, Astro.site);
---
<!doctype html>
<html lang="vi" data-nganh={nganh}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <!-- Open Graph: Zalo, Facebook, Messenger đọc các thẻ này để hiện khung xem trước khi dán link -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={img} />
  <meta property="og:locale" content="vi_VN" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={url} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Playfair+Display:ital,wght@1,700&display=swap" rel="stylesheet" />
  <!-- Chạy trước khi vẽ trang để không chớp màu: lấy lựa chọn cũ, không có thì theo hệ thống -->
  <script is:inline>
    try {
      const t = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = t;
    } catch (e) { document.documentElement.dataset.theme = 'light'; }
  </script>
</head>
<body class="font-sans antialiased">
  <slot />
</body>
</html>
