    <path d="M17 26h8" />
    <path class="sparkle" d="M38 8v8M34 12h8" />
    <path class="sparkle" d="M40 26v6M37 29h6" />
    <path class="sparkle" d="M7 30v6M4 33h6" />
  </svg>
)}
